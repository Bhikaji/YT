# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
.venv/

# Database & local data
data/*.db
data/*.db-journal

# Temporary Render Frame Dumps (keep folder, ignore thousands of individual frames)
output/renders/*
!output/renders/.gitkeep
output/stick_shorts/*
!output/stick_shorts/.gitkeep
output/*.mp3
output/*.png
output/*.wav
demo_video/analysis_frames/
demo_video/current_output_frames/
demo_video/new_pipeline_frames/
demo_video/*.wav
scripts/render_ep_*.py

# Sensitive Credentials
.env
credentials/client_secret.json
credentials/youtube_token.json
credentials/*.json
!credentials/.gitkeep

# Third-party cloned repositories & binaries (kept local and intact without submodule taint)
third_party/*
!third_party/.gitkeep
tools/*
!tools/.gitkeep
*.zip
*.tar.xz

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
