# Animation Engine Mode: 'COLAB_WAN', 'LOCAL_DIFFUSION', 'VEO_AI', 'BLENDER_3D'
ANIMATION_ENGINE_MODE=COLAB_WAN

# Path 1: 100% Free Cloud GPU Worker (Wan 2.1 / LTX-Video on Google Colab)
# Open scripts/Wan21_Free_AI_Video_Colab.ipynb on Colab and paste the gradio.live URL:
WAN21_API_URL=

# Path 2: Local GPU Diffusion (NVIDIA CUDA)
LOCAL_DIFFUSION_MODEL=Lightricks/LTX-Video
LOCAL_DIFFUSION_DEVICE=cuda

# Optional: Google Veo 3 / Gemini Video Generation
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview
