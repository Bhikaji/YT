    "# 🎬 100% Free Autonomous AI Video Server (Wan 2.1 / LTX-Video)\n",
    "### Generates Pixar/Veo-Quality 3D Character & Dinosaur Animations for Free\n",
    "This notebook runs on Google Colab's **Free T4 GPU** and exposes an API endpoint to connect with your local **Autonomous AI Cartoon Studio** (`E:\\YT`).\n",
    "\n",
    "**Instructions:**\n",
    "1. Go to **Runtime > Change runtime type** and ensure **T4 GPU** is selected.\n",
    "2. Click **Runtime > Run all**.\n",
    "3. Copy the public **`gradio.live`** URL printed at the bottom.\n",
    "4. Paste it into your local `E:\\YT\\.env` file as: `WAN21_API_URL=https://xxxx.gradio.live`."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Install High-Performance Diffusion & Video Generation Libraries\n",
    "!pip install -q diffusers transformers accelerate torch torchvision torchaudio gradio imageio-ffmpeg"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: Load Open-Source Cinematic Video Diffusion Pipeline\n",
    "import torch\n",
    "from diffusers import DiffusionPipeline\n",
    "import gradio as gr\n",
    "import tempfile\n",
    "import os\n",
    "\n",
    "print(\"Loading open-source cinematic video diffusion pipeline on Free T4 GPU...\")\n",
    "# Using LTX-Video / Wan 2.1 lightweight open pipeline optimized for 15GB T4 VRAM\n",
    "model_id = \"Lightricks/LTX-Video\"\n",
    "pipe = DiffusionPipeline.from_pretrained(model_id, torch_dtype=torch.float16)\n",
    "pipe.to(\"cuda\")\n",
    "pipe.enable_attention_slicing()\n",
    "print(\"✔ Pipeline loaded successfully on GPU!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Define Generation Function & Launch Public API Tunnel\n",
    "from diffusers.utils import export_to_video\n",
    "\n",
    "def generate_video(prompt: str, negative_prompt: str = \"blurry, low quality, distorted\", num_frames: int = 49):\n",
    "    print(f\"Generating video for prompt: {prompt[:80]}...\")\n",
    "    with torch.inference_mode():\n",
    "        video_frames = pipe(\n",
    "            prompt=prompt,\n",
    "            negative_prompt=negative_prompt,\n",
    "            num_frames=num_frames,\n",
    "            guidance_scale=7.5\n",
    "        ).frames[0]\n",
    "    \n",
    "    out_path = tempfile.mktemp(suffix=\".mp4\")\n",
    "    export_to_video(video_frames, out_path, fps=24)\n",
    "    print(f\"Video saved: {out_path}\")\n",
    "    return out_path\n",
    "\n",
    "demo = gr.Interface(\n",
    "    fn=generate_video,\n",
    "    inputs=[gr.Textbox(label=\"Prompt\"), gr.Textbox(label=\"Negative Prompt\", value=\"blurry, ugly, distorted\")],\n",
    "    outputs=gr.Video(label=\"Generated 3D Animation\"),\n",
    "    title=\"Autonomous AI Cartoon Studio - Free Video Backend\"\n",
    ")\n",
    "\n",
    "# Share=True creates the free public API tunnel URL for E:\\YT\n",
    "demo.launch(share=True)"
   ]
  }
 ]
}
